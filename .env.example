# DeepGuard Platform Environment Variables

# App Setup
APP_ENV=development
SECRET_KEY=deepguard_super_secret_key_change_in_production_32bytes
DEBUG=True
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Database Setup (SQLite for dev, PostgreSQL ready)
DATABASE_URL=sqlite:///./deepguard.db
# DATABASE_URL=postgresql://user:password@localhost:5432/deepguard

# Upload Controls
MAX_UPLOAD_SIZE_MB=100
ALLOWED_IMAGE_EXTENSIONS=["jpg", "jpeg", "png", "webp"]
ALLOWED_VIDEO_EXTENSIONS=["mp4", "mov", "avi", "webm"]
ALLOWED_AUDIO_EXTENSIONS=["mp3", "wav", "m4a"]
UPLOAD_DIR=./uploads
REPORT_DIR=./reports

# ML Model Settings
MODEL_CONFIG_PATH=./models/config.yaml
USE_GPU=False
